# ---------- Store ----------
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Public URL of the live site (used in metadata and in WhatsApp product links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (products and uploaded photos/videos) ----------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never expose this or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin ----------
# Secret part of the admin URL: https://your-site.vercel.app/admin/<ADMIN_PATH>
# Use a long random string (letters and numbers only), for example 9f3k2m7q8x4v1b6n.
ADMIN_PATH=
# Password asked after opening the secret URL. Use a long, unique password.
ADMIN_PASSWORD=
# Random string used to sign the login cookie (generate with: openssl rand -hex 32).
ADMIN_SESSION_SECRET=
